# ---- Database ----
POSTGRES_USER=wms
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=wms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wms:change-me-in-production@localhost:5432/wms
DATABASE_URL_TEST=postgresql://wms:change-me-in-production@localhost:5432/wms_test

# ---- API ----
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# 32+ random bytes, base64. Used to encrypt MFA secrets at rest. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Comma-separated list of allowed browser origins (CSRF / CORS)
ALLOWED_ORIGINS=http://localhost:5173
# Cookie secure flag (true behind HTTPS)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
UPLOAD_DIR=./uploads

# ---- Web ----
VITE_API_URL=http://localhost:4000
