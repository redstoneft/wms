# ---- Database ----
POSTGRES_USER=wms
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=wms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wms:change-me-in-production@localhost:5432/wms
DATABASE_URL_TEST=postgresql://wms:change-me-in-production@localhost:5432/wms_test

# ---- API ----
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# 32+ random bytes, base64. Used to encrypt MFA secrets at rest. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Comma-separated list of allowed browser origins (CSRF / CORS)
ALLOWED_ORIGINS=http://localhost:5173
# Cookie secure flag (true behind HTTPS). In production COOKIE_SECURE=false is refused unless ALLOW_INSECURE_COOKIE=true
COOKIE_SECURE=false
ALLOW_INSECURE_COOKIE=false
# Reverse proxy trust: 'false' (default, API exposed directly), 'true' (trust all — private network only) or a list of proxy IPs/CIDRs
TRUST_PROXY=false
SESSION_TTL_HOURS=12
UPLOAD_DIR=./uploads
# Optional: API key for external integrations (Aspel SAE connector). >= 24 chars. Disabled when empty.
INTEGRATION_API_KEY=
# Optional: webhook that receives a JSON message on every unhandled 500 (Slack/Discord/PagerDuty relay)
ERROR_WEBHOOK_URL=

# ---- Web ----
VITE_API_URL=http://localhost:4000

# ---- Aspel SAE integration (Supabase mirrors fed by the Windows connectors; read-only) ----
# ERP project (clean tables: sae_inventario, sae_compras, pedidos, ...) — service key
SAE_SUPABASE_URL=
SAE_SUPABASE_KEY=
# Raw mirror project (sae_inve01, sae_clie01, sae_prov01) — read-only anon key
SAE_RAW_SUPABASE_URL=
SAE_RAW_SUPABASE_KEY=
# Only import purchase orders issued in the last N days
SAE_PO_SINCE_DAYS=60
# Automatic sync cadence (0 = manual only)
SAE_SYNC_INTERVAL_MINUTES=30
