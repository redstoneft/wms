// =====================================================================
//  WMS — Data model
//  Conventions: snake_case everywhere (tables, columns, Prisma fields) so raw
//  SQL (locks, triggers, reconciliation) never needs quoted identifiers.
//  Quantities are BIGINT in the SKU base unit (PIECE). Never floats.
//  IDs are UUIDv7 (time-ordered) generated by PostgreSQL 18.
//  Ledger tables (inventory_movements, audit_logs) are append-only —
//  enforced by triggers in the migration SQL.
// =====================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// Security: users, roles, permissions, sessions
// ------------------------------------------------------------------

model users {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  username            String    @unique @db.VarChar(64)
  full_name           String    @db.VarChar(200)
  email               String?   @db.VarChar(254)
  password_hash       String    @db.VarChar(512)
  is_active           Boolean   @default(true)
  mfa_enabled         Boolean   @default(false)
  mfa_secret_enc      String?   @db.VarChar(512)
  failed_login_count  Int       @default(0)
  locked_until        DateTime? @db.Timestamptz(6)
  password_changed_at DateTime  @default(now()) @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user_roles user_roles[]
  sessions   sessions[]

  @@index([is_active])
}

model roles {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String  @unique @db.VarChar(40)
  name        String  @db.VarChar(100)
  description String?
  is_system   Boolean @default(false)

  user_roles       user_roles[]
  role_permissions role_permissions[]
}

model permissions {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String @unique @db.VarChar(80)
  description String

  role_permissions role_permissions[]
}

model role_permissions {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model user_roles {
  user_id String @db.Uuid
  role_id String @db.Uuid

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
}

model sessions {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token_hash    String    @unique @db.VarChar(128)
  user_id       String    @db.Uuid
  mfa_verified  Boolean   @default(false)
  ip            String?   @db.VarChar(64)
  user_agent    String?   @db.VarChar(512)
  device_id     String?   @db.VarChar(128)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at  DateTime  @default(now()) @db.Timestamptz(6)
  expires_at    DateTime  @db.Timestamptz(6)
  revoked_at    DateTime? @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

// Append-only. WHO / WHAT / WHEN / WHERE / BEFORE / AFTER / WHY.
model audit_logs {
  id          BigInt   @id @default(autoincrement())
  occurred_at DateTime @default(now()) @db.Timestamptz(6)
  user_id     String?  @db.Uuid
  username    String?  @db.VarChar(64)
  action      String   @db.VarChar(80)
  entity_type String   @db.VarChar(60)
  entity_id   String?  @db.VarChar(64)
  before      Json?
  after       Json?
  reason      String?
  ip          String?  @db.VarChar(64)
  device_id   String?  @db.VarChar(128)
  request_id  String?  @db.VarChar(64)

  @@index([entity_type, entity_id])
  @@index([user_id, occurred_at])
  @@index([occurred_at])
}

// Idempotency: one row per (user, key). Written in the SAME transaction as the
// business operation so a crash can never leave a movement without its key.
model idempotency_keys {
  scope_key     String   @id @db.VarChar(256)
  user_id       String   @db.Uuid
  fingerprint   String   @db.VarChar(128)
  response_code Int
  response_body Json
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  expires_at    DateTime @db.Timestamptz(6)

  @@index([expires_at])
}

model settings {
  key         String   @id @db.VarChar(80)
  value       Json
  description String?
  updated_by  String?  @db.Uuid
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// Supervisor authorizations for exceptions. UNIQUE partial index in SQL makes
// it impossible for two supervisors to approve the same exception twice.
model authorizations {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  exception_type String    @db.VarChar(60)
  entity_type    String    @db.VarChar(60)
  entity_id      String    @db.VarChar(64)
  requested_by   String    @db.Uuid
  supervisor_id  String    @db.Uuid
  reason         String
  status         String    @default("APPROVED") @db.VarChar(20) // APPROVED | REVOKED | CONSUMED
  consumed_at    DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id])
}

// ------------------------------------------------------------------
// Warehouse physical structure
// WAREHOUSE → ZONE → AISLE → RACK → (BAY, LEVEL, POSITION = location)
// Non-rack areas (docks, staging, quarantine) are locations with rack_id NULL
// and their own x/y/z footprint for the 3D twin.
// ------------------------------------------------------------------

model warehouses {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code       String   @unique @db.VarChar(20)
  name       String   @db.VarChar(120)
  address    String?
  width_m    Decimal  @default(60) @db.Decimal(8, 2)
  depth_m    Decimal  @default(40) @db.Decimal(8, 2)
  height_m   Decimal  @default(10) @db.Decimal(8, 2)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  zones     zones[]
  locations locations[]
  lpns      lpns[]
}

model zones {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouse_id String  @db.Uuid
  code         String  @db.VarChar(20)
  name         String  @db.VarChar(120)
  zone_type    String  @db.VarChar(30) // STORAGE | PICKING | RECEIVING | STAGING | SHIPPING | QUARANTINE | RETURNS | DAMAGED
  color        String? @db.VarChar(16)
  // footprint on the floor (meters)
  x_m          Decimal @default(0) @db.Decimal(8, 2)
  y_m          Decimal @default(0) @db.Decimal(8, 2)
  width_m      Decimal @default(10) @db.Decimal(8, 2)
  depth_m      Decimal @default(10) @db.Decimal(8, 2)
  is_active    Boolean @default(true)

  warehouse warehouses  @relation(fields: [warehouse_id], references: [id])
  aisles    aisles[]
  locations locations[]

  @@unique([warehouse_id, code])
}

model aisles {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  zone_id String @db.Uuid
  code    String @db.VarChar(20)
  name    String? @db.VarChar(120)

  zone  zones   @relation(fields: [zone_id], references: [id])
  racks racks[]

  @@unique([zone_id, code])
}

model racks {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  aisle_id       String  @db.Uuid
  code           String  @db.VarChar(20)
  bays           Int     @default(1)
  levels         Int     @default(1)
  positions_per_bay Int  @default(1)
  bay_width_m    Decimal @default(2.7) @db.Decimal(6, 2)
  level_height_m Decimal @default(1.8) @db.Decimal(6, 2)
  depth_m        Decimal @default(1.2) @db.Decimal(6, 2)
  // world placement
  x_m            Decimal @default(0) @db.Decimal(8, 2)
  y_m            Decimal @default(0) @db.Decimal(8, 2)
  rotation_deg   Int     @default(0)
  is_active      Boolean @default(true)

  aisle     aisles      @relation(fields: [aisle_id], references: [id])
  locations locations[]

  @@unique([aisle_id, code])
}

model locations {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouse_id     String   @db.Uuid
  zone_id          String?  @db.Uuid
  rack_id          String?  @db.Uuid
  code             String   @db.VarChar(40) // e.g. A-03-R05-N02-P04
  barcode          String   @unique @db.VarChar(64)
  location_type    String   @db.VarChar(30) // RESERVE | PICKING | RECEIVING | STAGING | SHIPPING | QUARANTINE | RETURNS | DAMAGED
  bay              Int?
  level            Int?
  position         Int?
  // physical
  width_m          Decimal  @default(1.2) @db.Decimal(6, 2)
  depth_m          Decimal  @default(1.2) @db.Decimal(6, 2)
  height_m         Decimal  @default(1.8) @db.Decimal(6, 2)
  pallet_capacity  Int      @default(1)
  max_weight_kg    Decimal  @default(1500) @db.Decimal(10, 2)
  // world coordinates (derived from rack geometry or set directly for areas)
  x_m              Decimal  @default(0) @db.Decimal(8, 2)
  y_m              Decimal  @default(0) @db.Decimal(8, 2)
  z_m              Decimal  @default(0) @db.Decimal(8, 2)
  // administrative state; occupancy (FREE/PARTIAL/OCCUPIED/RESERVED) is derived
  admin_status     String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | BLOCKED | QUARANTINE
  block_reason     String?
  restrictions     Json?    // { allowed_families?: string[], hazmat?: boolean, max_height_m?: number }
  pick_sequence    Int?     // route order for picking
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  warehouse warehouses @relation(fields: [warehouse_id], references: [id])
  zone      zones?     @relation(fields: [zone_id], references: [id])
  rack      racks?     @relation(fields: [rack_id], references: [id])

  lpns                 lpns[]
  replenishment_rules  replenishment_rules[]
  staging_assignments  staging_assignments[]

  @@unique([warehouse_id, code])
  @@index([rack_id])
  @@index([zone_id])
  @@index([location_type, admin_status])
}

// ------------------------------------------------------------------
// Master data
// ------------------------------------------------------------------

model skus {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code               String   @unique @db.VarChar(64)
  description        String   @db.VarChar(300)
  family             String?  @db.VarChar(60)
  compatibility_group String? @db.VarChar(60) // SKUs in different incompatible groups never share a location
  abc_class          String   @default("C") @db.VarChar(1)
  base_uom           String   @default("PIECE") @db.VarChar(10)
  unit_weight_kg     Decimal  @default(0) @db.Decimal(10, 4)
  case_length_cm     Decimal? @db.Decimal(8, 2)
  case_width_cm      Decimal? @db.Decimal(8, 2)
  case_height_cm     Decimal? @db.Decimal(8, 2)
  pallet_height_cm   Decimal? @db.Decimal(8, 2)
  requires_lot       Boolean  @default(false)
  requires_expiry    Boolean  @default(false)
  allow_negative     Boolean  @default(false) // explicit rule, default never
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  barcodes            sku_barcodes[]
  uoms                sku_uoms[]
  balances            inventory_balances[]
  movements           inventory_movements[]
  replenishment_rules replenishment_rules[]
  order_lines         order_lines[]
  po_lines            purchase_order_lines[]
  receipt_lines       receipt_lines[]
  allocations         allocations[]
  return_lines        return_lines[]
  count_lines         count_lines[]
}

model sku_barcodes {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sku_id   String @db.Uuid
  barcode  String @unique @db.VarChar(64)
  uom_code String @default("PIECE") @db.VarChar(10) // which packaging level this barcode identifies

  sku skus @relation(fields: [sku_id], references: [id], onDelete: Cascade)

  @@index([sku_id])
}

// Exact integer conversions: 1 <uom_code> = <base_qty> PIECE
model sku_uoms {
  sku_id   String @db.Uuid
  uom_code String @db.VarChar(10) // PALLET | CASE | INNER | PIECE
  base_qty BigInt

  sku skus @relation(fields: [sku_id], references: [id], onDelete: Cascade)

  @@id([sku_id, uom_code])
}

model suppliers {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(200)
  tax_id    String?  @db.VarChar(40)
  contact   String?
  is_active Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  purchase_orders purchase_orders[]
  containers      containers[]
  lpns            lpns[]
}

model customers {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(200)
  tax_id    String?  @db.VarChar(40)
  address   String?
  is_active Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  orders  orders[]
  returns returns[]
}

model carriers {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(200)
  is_active Boolean  @default(true)

  containers containers[]
  shipments  shipments[]
}

// ------------------------------------------------------------------
// Inbound: purchase orders, containers, receipts
// ------------------------------------------------------------------

model purchase_orders {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  po_number     String   @unique @db.VarChar(60)
  supplier_id   String   @db.Uuid
  status        String   @default("OPEN") @db.VarChar(20) // OPEN | PARTIAL | RECEIVED | CLOSED | CANCELLED
  expected_date DateTime? @db.Date
  notes         String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  created_by    String?  @db.Uuid

  supplier   suppliers              @relation(fields: [supplier_id], references: [id])
  lines      purchase_order_lines[]
  containers containers[]
}

model purchase_order_lines {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  po_id        String @db.Uuid
  line_no      Int
  sku_id       String @db.Uuid
  ordered_qty  BigInt // base units
  received_qty BigInt @default(0)
  uom_code     String @default("CASE") @db.VarChar(10)
  uom_qty      BigInt @default(0) // quantity as originally expressed

  po  purchase_orders @relation(fields: [po_id], references: [id], onDelete: Cascade)
  sku skus            @relation(fields: [sku_id], references: [id])

  @@unique([po_id, line_no])
  @@index([sku_id])
}

model containers {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  container_number  String    @unique @db.VarChar(40)
  supplier_id       String?   @db.Uuid
  po_id             String?   @db.Uuid
  carrier_id        String?   @db.Uuid
  bl_number         String?   @db.VarChar(80)
  seal_number       String?   @db.VarChar(80)
  plates            String?   @db.VarChar(40)
  driver_name       String?   @db.VarChar(120)
  status            String    @default("SCHEDULED") @db.VarChar(20) // SCHEDULED|ARRIVED|UNLOADING|UNLOADED|RECEIVING|RECEIVED|CLOSED|WITH_INCIDENT
  scheduled_at      DateTime? @db.Timestamptz(6)
  arrived_at        DateTime? @db.Timestamptz(6)
  opened_at         DateTime? @db.Timestamptz(6)
  unload_started_at DateTime? @db.Timestamptz(6)
  unload_finished_at DateTime? @db.Timestamptz(6)
  closed_at         DateTime? @db.Timestamptz(6)
  operator_id       String?   @db.Uuid
  dock_location_id  String?   @db.Uuid
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  created_by        String?   @db.Uuid
  version           Int       @default(1)

  supplier suppliers?       @relation(fields: [supplier_id], references: [id])
  po       purchase_orders? @relation(fields: [po_id], references: [id])
  carrier  carriers?        @relation(fields: [carrier_id], references: [id])
  receipts receipts[]
  lpns     lpns[]

  @@index([status])
}

model receipts {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  receipt_number String    @unique @db.VarChar(40)
  container_id   String?   @db.Uuid
  po_id          String?   @db.Uuid
  status         String    @default("OPEN") @db.VarChar(20) // OPEN | IN_PROGRESS | COMPLETED | CLOSED | WITH_INCIDENT
  receiving_location_id String @db.Uuid
  started_at     DateTime  @default(now()) @db.Timestamptz(6)
  completed_at   DateTime? @db.Timestamptz(6)
  closed_at      DateTime? @db.Timestamptz(6)
  received_by    String?   @db.Uuid
  notes          String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  container containers?     @relation(fields: [container_id], references: [id])
  lines     receipt_lines[]
  lpns      lpns[]

  @@index([status])
}

model receipt_lines {
  id            String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  receipt_id    String @db.Uuid
  sku_id        String @db.Uuid
  expected_qty  BigInt @default(0) // base units
  received_qty  BigInt @default(0)
  damaged_qty   BigInt @default(0)
  status        String @default("PENDING") @db.VarChar(20) // PENDING | PARTIAL | COMPLETE | OVER | SHORT

  receipt receipts @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  sku     skus     @relation(fields: [sku_id], references: [id])

  @@unique([receipt_id, sku_id])
}

// ------------------------------------------------------------------
// LPN — the digital identity of a pallet. Code from a never-reset sequence.
// An LPN is in exactly ONE location (current_location_id), therefore its
// inventory can never be in two places at once.
// ------------------------------------------------------------------

model lpns {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                String    @unique @db.VarChar(30)
  lpn_type            String    @default("INBOUND") @db.VarChar(20) // INBOUND | STORAGE | OUTBOUND | RETURN
  status              String    @default("OPEN") @db.VarChar(20) // OPEN | STORED | IN_TRANSFER | PICKING | STAGED | LOADED | SHIPPED | CONSUMED | CANCELLED
  warehouse_id        String    @db.Uuid
  current_location_id String?   @db.Uuid
  receipt_id          String?   @db.Uuid
  container_id        String?   @db.Uuid
  supplier_id         String?   @db.Uuid
  order_id            String?   @db.Uuid // outbound LPNs belong to an order
  shipment_id         String?   @db.Uuid
  cases_count         Int       @default(0)
  weight_kg           Decimal?  @db.Decimal(10, 3)
  length_cm           Decimal?  @db.Decimal(8, 2)
  width_cm            Decimal?  @db.Decimal(8, 2)
  height_cm           Decimal?  @db.Decimal(8, 2)
  lot                 String?   @db.VarChar(60)
  expiry_date         DateTime? @db.Date
  parent_lpn_id       String?   @db.Uuid // when split from another pallet
  version             Int       @default(1) // optimistic concurrency
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  created_by          String?   @db.Uuid
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  warehouse        warehouses  @relation(fields: [warehouse_id], references: [id])
  current_location locations?  @relation(fields: [current_location_id], references: [id])
  receipt          receipts?   @relation(fields: [receipt_id], references: [id])
  container        containers? @relation(fields: [container_id], references: [id])
  supplier         suppliers?  @relation(fields: [supplier_id], references: [id])
  order            orders?     @relation(fields: [order_id], references: [id])
  shipment         shipments?  @relation(fields: [shipment_id], references: [id])

  balances        inventory_balances[]
  movements_from  inventory_movements[] @relation("mov_from_lpn")
  movements_to    inventory_movements[] @relation("mov_to_lpn")
  putaway_tasks   putaway_tasks[]
  transfers       transfers[]
  allocations     allocations[]
  label_prints    label_prints[]

  @@index([current_location_id])
  @@index([status])
  @@index([order_id])
  @@index([shipment_id])
}

// Current balances. Derived from the ledger, maintained in the same
// transaction, CHECK (qty >= 0). Reconciliation rebuilds and compares.
model inventory_balances {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  lpn_id     String   @db.Uuid
  sku_id     String   @db.Uuid
  status     String   @db.VarChar(20) // AVAILABLE|ALLOCATED|PICKING|STAGING|LOADED|QUARANTINE|DAMAGED|BLOCKED|IN_TRANSFER
  qty        BigInt
  version    Int      @default(1)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  lpn lpns @relation(fields: [lpn_id], references: [id])
  sku skus @relation(fields: [sku_id], references: [id])

  @@unique([lpn_id, sku_id, status])
  @@index([sku_id, status])
}

// THE LEDGER. Append-only (trigger). Every quantity change in the warehouse.
model inventory_movements {
  id               BigInt    @id @default(autoincrement())
  movement_type    String    @db.VarChar(30)
  sku_id           String    @db.Uuid
  qty              BigInt    // base units, > 0
  uom_code         String    @default("PIECE") @db.VarChar(10) // as scanned/entered
  uom_qty          BigInt    @default(0)
  from_lpn_id      String?   @db.Uuid
  to_lpn_id        String?   @db.Uuid
  from_location_id String?   @db.Uuid
  to_location_id   String?   @db.Uuid
  from_status      String?   @db.VarChar(20)
  to_status        String?   @db.VarChar(20)
  user_id          String?   @db.Uuid
  device_id        String?   @db.VarChar(128)
  occurred_at      DateTime  @default(now()) @db.Timestamptz(6)
  reference_type   String?   @db.VarChar(40)
  reference_id     String?   @db.VarChar(64)
  order_id         String?   @db.Uuid
  receipt_id       String?   @db.Uuid
  shipment_id      String?   @db.Uuid
  transfer_id      String?   @db.Uuid
  task_id          String?   @db.Uuid
  incident_id      String?   @db.Uuid
  reason           String?   @db.VarChar(120)
  note             String?
  idempotency_key  String?   @db.VarChar(256)

  sku      skus  @relation(fields: [sku_id], references: [id])
  from_lpn lpns? @relation("mov_from_lpn", fields: [from_lpn_id], references: [id])
  to_lpn   lpns? @relation("mov_to_lpn", fields: [to_lpn_id], references: [id])

  @@index([sku_id, occurred_at])
  @@index([from_lpn_id])
  @@index([to_lpn_id])
  @@index([order_id])
  @@index([shipment_id])
  @@index([occurred_at])
  @@index([movement_type])
}

// ------------------------------------------------------------------
// Put-away, slotting, transfers, replenishment
// ------------------------------------------------------------------

model slotting_rules {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String  @db.VarChar(100)
  priority    Int     @default(100)
  is_active   Boolean @default(true)
  // weights of scoring criteria; explanation records each factor
  weights     Json    // { same_sku: 30, abc_proximity: 20, zone_match: 25, fill_rack: 10, level_low_heavy: 15 }
  conditions  Json?   // { family?: string, abc_class?: string, zone_type?: string }
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model putaway_tasks {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  lpn_id                String    @db.Uuid
  suggested_location_id String?   @db.Uuid
  final_location_id     String?   @db.Uuid
  status                String    @default("PENDING") @db.VarChar(20) // PENDING | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
  explanation           Json?     // why the engine chose the slot
  override_reason       String?
  override_by           String?   @db.Uuid
  assigned_to           String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  started_at            DateTime? @db.Timestamptz(6)
  completed_at          DateTime? @db.Timestamptz(6)
  version               Int       @default(1)

  lpn lpns @relation(fields: [lpn_id], references: [id])

  @@index([status])
  @@index([suggested_location_id])
}

model transfers {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  transfer_type    String    @default("LOCATION") @db.VarChar(20) // LOCATION | REPLENISHMENT | WAREHOUSE
  lpn_id           String    @db.Uuid
  from_location_id String    @db.Uuid
  to_location_id   String    @db.Uuid
  status           String    @default("IN_TRANSIT") @db.VarChar(20) // IN_TRANSIT | COMPLETED | CANCELLED
  origin_status    String    @default("AVAILABLE") @db.VarChar(20) // status the inventory had before IN_TRANSFER
  started_by       String    @db.Uuid
  completed_by     String?   @db.Uuid
  started_at       DateTime  @default(now()) @db.Timestamptz(6)
  completed_at     DateTime? @db.Timestamptz(6)
  reason           String?

  lpn lpns @relation(fields: [lpn_id], references: [id])

  @@index([status])
  @@index([lpn_id])
}

model replenishment_rules {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sku_id           String  @db.Uuid
  pick_location_id String  @db.Uuid
  min_qty          BigInt
  max_qty          BigInt
  is_active        Boolean @default(true)

  sku           skus      @relation(fields: [sku_id], references: [id])
  pick_location locations @relation(fields: [pick_location_id], references: [id])

  @@unique([sku_id, pick_location_id])
}

model replenishment_tasks {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  rule_id           String    @db.Uuid
  sku_id            String    @db.Uuid
  source_lpn_id     String?   @db.Uuid
  from_location_id  String?   @db.Uuid
  to_location_id    String    @db.Uuid
  qty               BigInt
  status            String    @default("PENDING") @db.VarChar(20) // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  transfer_id       String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  completed_at      DateTime? @db.Timestamptz(6)
  assigned_to       String?   @db.Uuid

  @@index([status])
}

// ------------------------------------------------------------------
// Cycle counting (blind)
// ------------------------------------------------------------------

model count_tasks {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  count_type   String    @db.VarChar(20) // LOCATION | SKU | ZONE | ABC | RANDOM | INCIDENT | SCHEDULED
  scope        Json      // { location_ids?: [], sku_ids?: [], zone_id?: string }
  status       String    @default("PENDING") @db.VarChar(20) // PENDING | IN_PROGRESS | RECOUNT | PENDING_APPROVAL | APPROVED | REJECTED | CLOSED
  is_blind     Boolean   @default(true)
  scheduled_for DateTime? @db.Timestamptz(6)
  assigned_to  String?   @db.Uuid
  incident_id  String?   @db.Uuid
  created_by   String    @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  approved_by  String?   @db.Uuid
  approved_at  DateTime? @db.Timestamptz(6)
  notes        String?

  lines count_lines[]

  @@index([status])
}

model count_lines {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  count_task_id String   @db.Uuid
  location_id   String   @db.Uuid
  lpn_id        String?  @db.Uuid
  sku_id        String   @db.Uuid
  system_qty    BigInt   // snapshot at count time (hidden from counter if blind)
  counted_qty   BigInt?
  recount_qty   BigInt?
  final_qty     BigInt?
  variance      BigInt?
  counted_by    String?  @db.Uuid
  counted_at    DateTime? @db.Timestamptz(6)
  recounted_by  String?  @db.Uuid
  recounted_at  DateTime? @db.Timestamptz(6)
  status        String   @default("PENDING") @db.VarChar(20) // PENDING | COUNTED | RECOUNT | MATCHED | VARIANCE | ADJUSTED | REJECTED
  adjustment_movement_id BigInt?

  count_task count_tasks @relation(fields: [count_task_id], references: [id], onDelete: Cascade)
  sku        skus        @relation(fields: [sku_id], references: [id])

  @@index([count_task_id])
}

// ------------------------------------------------------------------
// Outbound: orders, allocation, picking, staging, verification,
// shipments, loading, release
// ------------------------------------------------------------------

model orders {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  order_number  String    @unique @db.VarChar(60)
  customer_id   String    @db.Uuid
  destination   String?
  order_date    DateTime? @db.Date
  priority      Int       @default(5) // 1 = highest
  status        String    @default("IMPORTED") @db.VarChar(20)
  // IMPORTED | ACCEPTED | ALLOCATED | PARTIALLY_ALLOCATED | PICKING | PICKED | STAGED | VERIFIED | LOADING | LOADED | SHIPPED | CANCELLED
  source        String    @default("IMPORT") @db.VarChar(20) // IMPORT | MANUAL | SAE
  external_ref  String?   @db.VarChar(80)
  shipment_id   String?   @db.Uuid
  picker_id     String?   @db.Uuid
  verifier_id   String?   @db.Uuid
  verified_at   DateTime? @db.Timestamptz(6)
  notes         String?
  version       Int       @default(1)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  created_by    String?   @db.Uuid
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  customer  customers  @relation(fields: [customer_id], references: [id])
  shipment  shipments? @relation(fields: [shipment_id], references: [id])
  lines     order_lines[]
  lpns      lpns[]
  pick_tasks pick_tasks[]
  staging_assignments staging_assignments[]
  verifications verifications[]
  returns   returns[]

  @@index([status])
  @@index([customer_id])
  @@index([shipment_id])
}

// REQUIRED / ALLOCATED / PICKED / VERIFIED / LOADED are kept separately and
// never inferred from each other. All in base units.
model order_lines {
  id            String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  order_id      String @db.Uuid
  line_no       Int
  sku_id        String @db.Uuid
  required_qty  BigInt
  uom_code      String @default("PIECE") @db.VarChar(10)
  uom_qty       BigInt @default(0)
  allocated_qty BigInt @default(0)
  picked_qty    BigInt @default(0)
  verified_qty  BigInt @default(0)
  loaded_qty    BigInt @default(0)

  order orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  sku   skus   @relation(fields: [sku_id], references: [id])
  allocations allocations[]
  pick_lines  pick_task_lines[]

  @@unique([order_id, line_no])
  @@index([sku_id])
}

model allocations {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  order_line_id String   @db.Uuid
  lpn_id        String   @db.Uuid
  sku_id        String   @db.Uuid
  qty           BigInt
  picked_qty    BigInt   @default(0)
  status        String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | PICKED | RELEASED
  strategy      String   @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  order_line order_lines @relation(fields: [order_line_id], references: [id])
  lpn        lpns        @relation(fields: [lpn_id], references: [id])
  sku        skus        @relation(fields: [sku_id], references: [id])

  @@index([lpn_id, status])
  @@index([order_line_id])
}

model pick_tasks {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  order_id     String    @db.Uuid
  status       String    @default("PENDING") @db.VarChar(20) // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  assigned_to  String?   @db.Uuid
  outbound_lpn_id String? @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  started_at   DateTime? @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  version      Int       @default(1)

  order orders            @relation(fields: [order_id], references: [id])
  lines pick_task_lines[]

  @@index([status])
  @@index([assigned_to])
}

// One line = one visit: location → LPN → SKU → qty, in route order.
model pick_task_lines {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pick_task_id   String   @db.Uuid
  order_line_id  String   @db.Uuid
  allocation_id  String   @db.Uuid
  sequence       Int
  location_id    String   @db.Uuid
  lpn_id         String   @db.Uuid
  sku_id         String   @db.Uuid
  qty            BigInt
  picked_qty     BigInt   @default(0)
  full_pallet    Boolean  @default(false)
  status         String   @default("PENDING") @db.VarChar(20) // PENDING | IN_PROGRESS | PICKED | SHORT | CANCELLED
  // scan step state machine: 0 none, 1 location ok, 2 lpn ok
  scan_step      Int      @default(0)
  picked_at      DateTime? @db.Timestamptz(6)

  pick_task  pick_tasks  @relation(fields: [pick_task_id], references: [id], onDelete: Cascade)
  order_line order_lines @relation(fields: [order_line_id], references: [id])

  @@index([pick_task_id, sequence])
}

model staging_assignments {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  order_id    String    @db.Uuid
  location_id String    @db.Uuid
  assigned_at DateTime  @default(now()) @db.Timestamptz(6)
  released_at DateTime? @db.Timestamptz(6)

  order    orders    @relation(fields: [order_id], references: [id])
  location locations @relation(fields: [location_id], references: [id])

  @@index([location_id, released_at])
}

model verifications {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  order_id      String    @db.Uuid
  verifier_id   String    @db.Uuid
  status        String    @default("IN_PROGRESS") @db.VarChar(20) // IN_PROGRESS | PASSED | FAILED | CANCELLED
  same_user_authorization_id String? @db.Uuid
  started_at    DateTime  @default(now()) @db.Timestamptz(6)
  completed_at  DateTime? @db.Timestamptz(6)
  notes         String?

  order orders               @relation(fields: [order_id], references: [id])
  lines verification_lines[]

  @@index([order_id])
}

model verification_lines {
  id              String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  verification_id String @db.Uuid
  sku_id          String @db.Uuid
  lpn_id          String? @db.Uuid
  expected_qty    BigInt
  scanned_qty     BigInt @default(0)

  verification verifications @relation(fields: [verification_id], references: [id], onDelete: Cascade)

  @@unique([verification_id, sku_id, lpn_id])
}

model shipments {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipment_number  String    @unique @db.VarChar(40)
  carrier_id       String?   @db.Uuid
  vehicle          String?   @db.VarChar(80)
  plates           String?   @db.VarChar(40)
  driver_name      String?   @db.VarChar(120)
  destination      String?
  dock_location_id String?   @db.Uuid
  status           String    @default("OPEN") @db.VarChar(20) // OPEN | LOADING | LOADED | RELEASED | DEPARTED | CANCELLED | BLOCKED
  loading_started_at DateTime? @db.Timestamptz(6)
  loading_finished_at DateTime? @db.Timestamptz(6)
  released_at      DateTime? @db.Timestamptz(6)
  released_by      String?   @db.Uuid
  departed_at      DateTime? @db.Timestamptz(6)
  release_check    Json?     // last release validation result (per SKU per order)
  notes            String?
  version          Int       @default(1)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  created_by       String?   @db.Uuid

  carrier carriers? @relation(fields: [carrier_id], references: [id])
  orders  orders[]
  lpns    lpns[]

  @@index([status])
}

// ------------------------------------------------------------------
// Incidents, quarantine reasons, returns
// ------------------------------------------------------------------

model incidents {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  incident_number String  @unique @db.VarChar(40)
  incident_type String    @db.VarChar(30)
  // SHORTAGE|OVERAGE|WRONG_SKU|DAMAGED|INVENTORY_DIFFERENCE|WRONG_LOCATION|LABEL_ERROR|LOST_PALLET|PICKING_ERROR|LOADING_ERROR|OTHER
  severity      String    @default("MEDIUM") @db.VarChar(10) // LOW | MEDIUM | HIGH | CRITICAL
  status        String    @default("OPEN") @db.VarChar(20) // OPEN | IN_REVIEW | RESOLVED | CLOSED | REJECTED
  title         String    @db.VarChar(200)
  description   String?
  entity_type   String?   @db.VarChar(40)
  entity_id     String?   @db.VarChar(64)
  sku_id        String?   @db.Uuid
  lpn_id        String?   @db.Uuid
  location_id   String?   @db.Uuid
  order_id      String?   @db.Uuid
  shipment_id   String?   @db.Uuid
  receipt_id    String?   @db.Uuid
  qty           BigInt?
  reported_by   String    @db.Uuid
  assigned_to   String?   @db.Uuid
  resolution    String?
  resolved_by   String?   @db.Uuid
  resolved_at   DateTime? @db.Timestamptz(6)
  authorized_by String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  comments incident_comments[]

  @@index([status, severity])
  @@index([entity_type, entity_id])
}

model incident_comments {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  incident_id String   @db.Uuid
  user_id     String   @db.Uuid
  body        String
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  incident incidents @relation(fields: [incident_id], references: [id], onDelete: Cascade)
}

model quarantine_reasons {
  code        String  @id @db.VarChar(40)
  description String
  is_active   Boolean @default(true)
}

model returns {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  return_number   String    @unique @db.VarChar(40)
  customer_id     String    @db.Uuid
  original_order_id String? @db.Uuid
  status          String    @default("OPEN") @db.VarChar(20) // OPEN | RECEIVED | INSPECTING | CLASSIFIED | CLOSED
  reason          String?
  received_by     String?   @db.Uuid
  received_at     DateTime? @db.Timestamptz(6)
  closed_at       DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  created_by      String?   @db.Uuid

  customer       customers @relation(fields: [customer_id], references: [id])
  original_order orders?   @relation(fields: [original_order_id], references: [id])
  lines          return_lines[]
}

model return_lines {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  return_id      String  @db.Uuid
  sku_id         String  @db.Uuid
  expected_qty   BigInt  @default(0)
  received_qty   BigInt  @default(0)
  disposition    String? @db.VarChar(20) // RESTOCK | QUARANTINE | DAMAGED | SCRAP
  disposition_qty BigInt @default(0)
  lpn_id         String? @db.Uuid
  inspected_by   String? @db.Uuid
  notes          String?

  return_ returns @relation(fields: [return_id], references: [id], onDelete: Cascade)
  sku     skus    @relation(fields: [sku_id], references: [id])
}

// ------------------------------------------------------------------
// Attachments (photos), printers, label prints, imports
// ------------------------------------------------------------------

model attachments {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entity_type  String   @db.VarChar(40)
  entity_id    String   @db.VarChar(64)
  file_name    String   @db.VarChar(255)
  mime_type    String   @db.VarChar(100)
  size_bytes   Int
  storage_path String   @db.VarChar(512)
  sha256       String   @db.VarChar(64)
  uploaded_by  String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id])
}

model printers {
  id         String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code       String  @unique @db.VarChar(40)
  name       String  @db.VarChar(120)
  host       String  @db.VarChar(255)
  port       Int     @default(9100)
  dpi        Int     @default(203)
  label_width_mm  Int @default(100)
  label_height_mm Int @default(150)
  is_active  Boolean @default(true)
  is_default Boolean @default(false)
}

model label_prints {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  label_type   String   @db.VarChar(20) // LPN | LOCATION | CASE | ORDER | STAGING | SHIPMENT
  entity_id    String   @db.VarChar(64)
  lpn_id       String?  @db.Uuid
  printer_id   String?  @db.Uuid
  is_reprint   Boolean  @default(false)
  reprint_reason String?
  printed_by   String   @db.Uuid
  zpl          String
  status       String   @default("QUEUED") @db.VarChar(20) // QUEUED | SENT | FAILED | PREVIEW
  error        String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  lpn lpns? @relation(fields: [lpn_id], references: [id])

  @@index([label_type, entity_id])
}

model import_jobs {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  import_type   String   @db.VarChar(30) // SKUS|BARCODES|CUSTOMERS|SUPPLIERS|LOCATIONS|RACKS|INITIAL_INVENTORY|ORDERS|PURCHASE_ORDERS
  file_name     String   @db.VarChar(255)
  file_sha256   String   @db.VarChar(64)
  status        String   @default("VALIDATED") @db.VarChar(20) // VALIDATED | REJECTED | APPLIED | FAILED
  total_rows    Int      @default(0)
  valid_rows    Int      @default(0)
  error_rows    Int      @default(0)
  errors        Json?    // [{ row, column, message }]
  summary       Json?
  created_by    String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  applied_at    DateTime? @db.Timestamptz(6)

  @@index([import_type, file_sha256])
}

model sequences_meta {
  name        String @id @db.VarChar(40)
  prefix      String @db.VarChar(10)
  description String?
}
